<span class="star-rating-stars" role="img" aria-label="{{ rating }}/5">
  {%- for i in (1..5) -%}
    {%- if i <= rating -%}
      <span class="star-rating-star star-rating-star-filled" aria-hidden="true">&#9733;</span>
    {%- else -%}
      <span class="star-rating-star" aria-hidden="true">&#9734;</span>
    {%- endif -%}
  {%- endfor -%}
</span>
